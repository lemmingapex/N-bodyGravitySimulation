{
	"compilerOptions": {
		"target": "ES2022",
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"lib": ["ES2023", "DOM", "DOM.Iterable"],
		"types": ["node"],
		"checkJs": true,
		"allowJs": true,
		"strict": true,
		"noEmit": true,
		"skipLibCheck": true,
		"maxNodeModuleJsDepth": 0
	},
	"include": ["src/**/*.js", "test/**/*.js", "scripts/**/*.js", "vendor/**/*.d.ts"]
}
